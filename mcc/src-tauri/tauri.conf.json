{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HK Operator",
  "version": "0.2.0",
  "identifier": "dev.hkoperator.mcc",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1420/?mcc=6p5",
    "beforeDevCommand": "python3 scripts/dev-static.py",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HK Operator",
        "width": 1180,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
